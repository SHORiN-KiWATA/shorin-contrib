#!/bin/bash
# 描述： 更新系统根
# Description: Update system

# 开启严格模式：遇到错误、未定义变量、管道错误即停止运行
set -euo pipefail

# ===============================================================
# Arch Linux 系统更新助手
# 官方仓库 (pacman -Syu) 与 AUR 分开升级：
#   - 官方仓库升级失败 = 部分升级状态，致命警告并退出
#   - AUR 升级失败不影响系统完整性，仅提示并继续后续步骤
# ===============================================================

# ------------------------------
# 1. Default parameters & Language Detection
# ------------------------------
COUNT_LIMIT=15
NEWS_SOURCE="official"
SHOW_LIST=0
MIRROR_MAX_DAYS=30

# 按 gettext 的优先级判断：LC_ALL > LC_MESSAGES > LANG；
# 非 C/POSIX locale 时 LANGUAGE (如 zh_CN:en) 优先生效
MSG_LOCALE="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
if [[ -n "${LANGUAGE:-}" && ! "$MSG_LOCALE" =~ ^(C|POSIX)?(\.|$) ]]; then
  MSG_LOCALE="${LANGUAGE%%:*}"
fi

if [[ "$MSG_LOCALE" == zh_CN* ]]; then
  UI_LANG="zh"
else
  UI_LANG="en"
fi

# ------------------------------
# 2. Define Colors
# ------------------------------
NC='\033[0m'
H_RED='\033[1;31m'
H_GREEN='\033[1;32m'
H_YELLOW='\033[1;33m'
H_BLUE='\033[1;34m'
H_CYAN='\033[1;36m'

# ------------------------------
# 3. Argument parsing
# ------------------------------
usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -l, --list                 Refresh and open the pending updates list (no update is performed)
  --ui-lang zh|en            UI language (default: auto)
  --news-source official|cn  News source (default: official)
  --count N                  Max number of news items (default: 15)
  --help, -h                 Show this help and exit
EOF
}

die_usage() {
  printf "Error: %s\n\n" "$1" >&2
  usage >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -l | --list) SHOW_LIST=1; shift ;;
  --ui-lang) [[ "${2:-}" =~ ^(zh|en)$ ]] && UI_LANG="$2" && shift 2 || die_usage "--ui-lang requires zh or en." ;;
  --news-source) [[ "${2:-}" =~ ^(official|cn)$ ]] && NEWS_SOURCE="$2" && shift 2 || die_usage "--news-source requires official or cn." ;;
  --count) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] && COUNT_LIMIT="$2" && shift 2 || die_usage "--count requires a positive number." ;;
  --help | -h) usage; exit 0 ;;
  *) die_usage "Unknown option: $1" ;;
  esac
done

# ------------------------------
# 4. Localization Logic
# ------------------------------
declare -A MSG
if [[ "$UI_LANG" == "zh" ]]; then
  TAG_INFO="[消息]"
  TAG_SUCCESS="[成功]"
  TAG_WARN="[注意]"
  TAG_ERROR="[错误]"

  MSG[SYNCING_DATA]="⏳ 正在同步最新软件库数据，请稍候..."
  MSG[NO_UI]="未找到更新列表命令 (shorin checkallupdates)，请确认已安装 shorin-contrib。"

  MSG[INTRO_HEADER]="=== Arch Linux 系统更新助手 ==="
  MSG[INTRO_DESC]="获取并确认 Arch Linux 新闻后，将依次执行："
  INTRO_STEPS=(
    "检查镜像源时效并按需更新"
    "同步软件数据库并更新 GPG 密钥环"
    "升级官方仓库软件包 (pacman -Su)"
    "升级 AUR 软件包"
    "更新 Flatpak 应用"
    "重新生成 GRUB 配置文件"
  )
  MSG[INTRO_SNAP]="(Btrfs 系统且安装了 quicksave 时，会先创建快照)"

  MSG[REQ_SUDO]="正在请求管理员权限以更新系统..."
  MSG[SUDO_FAIL]="需要管理员权限才能更新系统。已退出。"

  MSG[PREPARING]="准备更新系统 (%s)..."
  MSG[FETCHING]="正在获取 Arch Linux 新闻..."
  MSG[NEWS_HEADER]="最近 {0} 条 Arch Linux 新闻："
  MSG[CONFIRM]="请阅读上述新闻。确认开始更新吗？"
  MSG[CANCEL]="更新已取消。"
  MSG[ERR_FETCH]="获取新闻失败（网络或源错误）"
  MSG[FORCE_ASK]="是否忽略新闻强制更新？"
  MSG[FORCING]="正在强制更新..."
  MSG[EXIT]="安全退出。"

  MSG[SNAP]="正在创建 Btrfs 快照..."
  MSG[SNAP_FAIL]="Btrfs 快照创建失败。是否在没有快照的情况下继续？"

  MSG[STEP_MIRROR]="检查镜像源时效性..."
  MSG[MIR_OLD]="镜像源已 %s 天未更新 (>%s天)。是否更新？"
  MSG[MIR_FRESH]="镜像源很新鲜 (生成于 %s 天前)。"
  MSG[MIR_UPDATING]="正在运行镜像更新脚本..."
  MSG[MIR_UPDATE_FAIL]="镜像更新脚本执行失败，继续使用当前镜像源。"
  MSG[MIR_SKIP]="跳过镜像源更新。"
  MSG[MIR_NO_STAMP]="镜像源不是由 Reflector 生成，跳过检查。"

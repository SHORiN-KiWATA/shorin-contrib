fi

# ------------------------------
# 5. Logging & Prompt Functions
# ------------------------------
_log()     { local fmt=$1; shift; printf "${H_BLUE}${TAG_INFO}${NC} ${fmt}\n" "$@"; }
_success() { local fmt=$1; shift; printf "${H_GREEN}${TAG_SUCCESS}${NC} ${fmt}\n" "$@"; }
_warn()    { local fmt=$1; shift; printf "${H_YELLOW}${TAG_WARN}${NC} ${fmt}\n" "$@"; }
_error()   { local fmt=$1; shift; printf "${H_RED}${TAG_ERROR}${NC} ${fmt}\n" "$@"; exit 1; }

STEP_TOTAL=${#INTRO_STEPS[@]}
STEP_NUM=0
_step() { STEP_NUM=$((STEP_NUM + 1)); _log "[%d/%d] ${1}" "$STEP_NUM" "$STEP_TOTAL" "${@:2}"; }

# ask <Y|N> <message>：返回 0 表示"是"。输入读取失败 (EOF / 非终端) 一律视为"否"。
ask() {
  local default=$1 msg=$2 hint answer
  [[ "$default" == "Y" ]] && hint="[Y/n]" || hint="[y/N]"
  printf "%s %s " "$msg" "$hint"
  if ! read -r answer; then
    printf "\n"
    return 1
  fi
  answer=${answer:-$default}
  [[ "$answer" =~ ^[Yy] ]]
}

# ===============================================================
# -l：唤醒 Waybar 后台脚本刷新缓存，等待其写完后打开更新列表
# ===============================================================
if [[ $SHOW_LIST == 1 ]]; then
  printf "\n${H_CYAN}%s${NC}\n" "${MSG[SYNCING_DATA]}"

  # 唤醒 Waybar 守护进程拉取最新数据，短暂避让让它先拿到文件锁
  pkill -SIGUSR1 -f "check-updates.sh" || true
  sleep 0.2

  # 复用 Waybar 锁文件阻塞等待：锁被释放即代表缓存已是最新
  ( flock -x -w 120 9 ) 9>"/tmp/waybar-updates.lock" || true

  command -v shorin >/dev/null 2>&1 || _error "${MSG[NO_UI]}"
  exec shorin checkallupdates
fi

# ------------------------------
# 6. Intro & Request Privileges
# ------------------------------
clear
printf "\n${H_CYAN}%s${NC}\n" "${MSG[INTRO_HEADER]}"
printf "%s\n" "${MSG[INTRO_DESC]}"
for i in "${!INTRO_STEPS[@]}"; do
  printf "  %d. %s\n" "$((i + 1))" "${INTRO_STEPS[$i]}"
done
printf "  %s\n\n" "${MSG[INTRO_SNAP]}"

_log "${MSG[REQ_SUDO]}"
sudo -v || _error "${MSG[SUDO_FAIL]}"

while true; do
  sudo -n true
  sleep 60
done >/dev/null 2>&1 &
SUDO_PID=$!
trap 'kill $SUDO_PID 2>/dev/null || true' EXIT

# ------------------------------
# 7. Detect AUR Helper (optional)
# ------------------------------
AUR_HELPER=""
AUR_ARGS=()
if command -v paru >/dev/null 2>&1; then
  AUR_HELPER="paru"
  AUR_ARGS=(-Sua --skipreview)
elif command -v yay >/dev/null 2>&1; then
  AUR_HELPER="yay"
  AUR_ARGS=(-Sua --answeredit None)
fi

# ------------------------------
# 8. Update Steps
# ------------------------------
take_snapshot() {
  command -v quicksave >/dev/null 2>&1 || return 0
  [[ "$(findmnt -no FSTYPE /)" == "btrfs" ]] || return 0

  _log "${MSG[SNAP]}"
  if ! quicksave -d quicksave-sysup; then
    printf "${H_YELLOW}${TAG_WARN}${NC} "
    ask N "${MSG[SNAP_FAIL]}" || { _log "${MSG[EXIT]}"; exit 1; }
  fi
}

find_mirror_script() {
  if command -v mirror-update >/dev/null 2>&1; then
    command -v mirror-update
  elif [[ -x /usr/lib/shorin-contrib/mirror-update ]]; then
    printf "%s\n" /usr/lib/shorin-contrib/mirror-update
  else
    return 1
  fi
}

check_mirror_age() {
  _step "${MSG[STEP_MIRROR]}"
  local mirror_list="/etc/pacman.d/mirrorlist"
  local when_str file_ts days_old script

  when_str=$(sed -n 's/^# When:[[:space:]]*//p;T;q' "$mirror_list" 2>/dev/null || true)
  if [[ -z "$when_str" ]]; then
    _log "${MSG[MIR_NO_STAMP]}"
    return
  fi

  if ! file_ts=$(date -u -d "${when_str% UTC}" +%s 2>/dev/null); then
    _warn "${MSG[MIR_BAD_STAMP]}"
    return
  fi

  days_old=$((($(date +%s) - file_ts) / 86400))
  if ((days_old <= MIRROR_MAX_DAYS)); then
    _log "${MSG[MIR_FRESH]}" "$days_old"
    return
  fi

  printf "${H_YELLOW}${TAG_WARN}${NC} "
  # shellcheck disable=SC2059
  if ! ask Y "$(printf "${MSG[MIR_OLD]}" "$days_old" "$MIRROR_MAX_DAYS")"; then
    _log "${MSG[MIR_SKIP]}"
    return
  fi

  if ! script=$(find_mirror_script); then
    _warn "${MSG[MIR_NO_SCRIPT]}"
    return
  fi

  _log "${MSG[MIR_UPDATING]}"
  "$script" || _warn "${MSG[MIR_UPDATE_FAIL]}"
}

sync_keyrings() {
  _step "${MSG[STEP_SYNC]}"
  local targets=("archlinux-keyring")
  if grep -q "^\[archlinuxcn\]" /etc/pacman.conf; then
    targets+=("archlinuxcn-keyring")
  fi

  if sudo pacman -Sy --needed --noconfirm "${targets[@]}"; then
    _success "${MSG[KEYRING_OK]}"
  else
    _warn "${MSG[KEYRING_WARN]}"
  fi
}

# 【防部分升级核心】数据库已在上一步同步，这里失败即处于部分升级状态
upgrade_repos() {
  _step "${MSG[STEP_REPO]}"
  if ! sudo pacman -Su; then
    printf "\n${H_RED}======================================================================${NC}\n"
    printf "${H_RED}%s${NC}\n" "${MSG[WARN_PARTIAL_TITLE]}"
    printf "${H_YELLOW}• %s${NC}\n" "${MSG[WARN_PARTIAL_1]}"
    printf "${H_YELLOW}• %s${NC}\n" "${MSG[WARN_PARTIAL_2]}"
    printf "${H_YELLOW}• %s${NC}\n" "${MSG[WARN_PARTIAL_3]}"
    printf "${H_RED}======================================================================${NC}\n\n"
    exit 1
  fi
  _success "${MSG[REPO_OK]}"
}

upgrade_aur() {
  if [[ -z "$AUR_HELPER" ]]; then
    _step "${MSG[STEP_AUR]}" "-"
    _log "${MSG[AUR_NONE]}"
    return
  fi

  _step "${MSG[STEP_AUR]}" "$AUR_HELPER"
  if "$AUR_HELPER" "${AUR_ARGS[@]}"; then
    _success "${MSG[AUR_OK]}"
  else
    _warn "${MSG[AUR_FAIL]}"
    _warn "${MSG[AUR_RETRY]}" "$AUR_HELPER -Sua"
  fi
}

update_flatpak() {
  _step "${MSG[STEP_FLATPAK]}"
  if ! command -v flatpak >/dev/null 2>&1; then
    _log "${MSG[FLATPAK_NONE]}"
    return
  fi
  flatpak update -y || _warn "${MSG[FLATPAK_FAIL]}"
}

update_grub() {
  _step "${MSG[STEP_GRUB]}"
  if ! command -v grub-mkconfig >/dev/null 2>&1; then
    _log "${MSG[GRUB_NONE]}"
    return
  fi

  # 菜单项保持英文 (GRUB 默认字体无中文)。必须用 LC_ALL=C.UTF-8：
  # 仅设 LANG 时，sudo 保留下来的 LANGUAGE=zh_CN:en 仍会让 gettext 输出中文
  if sudo env -u LANGUAGE LC_ALL=C.UTF-8 grub-mkconfig -o /boot/grub/grub.cfg; then
    _success "${MSG[GRUB_OK]}"
  else
    _warn "${MSG[GRUB_FAIL]}"
  fi
}

perform_update() {
  take_snapshot
  check_mirror_age
  sync_keyrings
  upgrade_repos
  upgrade_aur
  update_flatpak
  update_grub

  pkill -SIGUSR1 -f "check-updates.sh" || true
  printf "\n"
  _success "${MSG[DONE]}"
}

# ------------------------------
# 9. News
# ------------------------------
NEWS_PARSER=$(
  cat <<'EOF'
import sys
import xml.etree.ElementTree as ET
try:
    def clean_text(value):
        value = value or ''
        return ''.join(
            ch for ch in value.strip()
            if ord(ch) >= 32 and not 127 <= ord(ch) <= 159
        )

    def item_text(item, tag):
        element = item.find(tag)
        return clean_text(element.text if element is not None else '')

    def terminal_link(text, url):
        url = clean_text(url)
        if not url:
            return text
        return f'\033]8;;{url}\033\\{text}\033]8;;\033\\'

    limit = int(sys.argv[1])
    header_template = sys.argv[2]
    sys.stdin.reconfigure(encoding='utf-8')
    raw_data = sys.stdin.read()
    if not raw_data.strip(): sys.exit(1)
    root = ET.fromstring(raw_data)
    items = root.findall('./channel/item')[:limit]
    print(f'\n\033[1;33m{header_template.format(len(items))}\033[0m\n')
    for item in items:
        title = item_text(item, 'title') or '(untitled)'
        pub_date = item_text(item, 'pubDate')
        link = item_text(item, 'link')
        date_str = pub_date[:16] if pub_date else 'No date'
        check_text = title.lower()
        if any(x in check_text for x in ['intervention', 'manual', '手动', '干预']):
            color = '\033[1;31m'; prefix = '!!! '
        else:
            color = '\033[1;32m'; prefix = ''
        line = f'[{date_str}] {prefix}{title}'
        print(f'{color}{terminal_link(line, link)}\033[0m')
except Exception as e:
    sys.stderr.write(f'\nParse Error: {e}\n')
    sys.exit(1)
EOF
)

if [[ "$NEWS_SOURCE" == "cn" ]]; then
  NEWS_URL="https://www.archlinuxcn.org/category/news/feed/"
else
  NEWS_URL="https://archlinux.org/feeds/news/"
fi

# ------------------------------
# 10. Main Execution
# ------------------------------
_log "${MSG[PREPARING]}" "pacman${AUR_HELPER:+ + $AUR_HELPER}"
_log "${MSG[FETCHING]}"

if curl -fsSL --connect-timeout 15 --max-time 30 -A "Mozilla/5.0" "$NEWS_URL" |
  python -c "$NEWS_PARSER" "$COUNT_LIMIT" "${MSG[NEWS_HEADER]}"; then
  printf "\n"
  if ask Y "${MSG[CONFIRM]}"; then
    perform_update
  else
    _warn "${MSG[CANCEL]}"
  fi
else
  printf "\n"
  _warn "${MSG[ERR_FETCH]}"
  if ask N "${MSG[FORCE_ASK]}"; then
    _warn "${MSG[FORCING]}"
    perform_update
  else
    _log "${MSG[EXIT]}"
    exit 1
  fi
fi

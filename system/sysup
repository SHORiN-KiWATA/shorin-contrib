  MSG[AUR_FAIL]="AUR 软件包升级失败或被取消。官方仓库已完成升级，系统本身是完整的。"
  MSG[AUR_RETRY]="排查问题后可单独重试：%s"

  MSG[STEP_FLATPAK]="检查 Flatpak 更新..."
  MSG[FLATPAK_NONE]="未安装 Flatpak，跳过。"
  MSG[FLATPAK_FAIL]="Flatpak 更新失败，继续后续步骤。"

  MSG[STEP_GRUB]="更新 GRUB 配置..."
  MSG[GRUB_OK]="GRUB 更新成功。"
  MSG[GRUB_FAIL]="GRUB 更新失败。"
  MSG[GRUB_NONE]="未找到 grub-mkconfig，跳过。"

  MSG[DONE]="系统更新完成。"

  MSG[WARN_PARTIAL_TITLE]="[致命警告] 官方仓库升级被中断或发生冲突失败！"
  MSG[WARN_PARTIAL_1]="您的本地软件库数据库已被更新，但软件包尚未成功升级。"
  MSG[WARN_PARTIAL_2]="【绝对禁止】在此状态下运行 pacman -S 安装新软件，这会导致部分升级进而损坏系统！"
  MSG[WARN_PARTIAL_3]="请尽快排查冲突原因，并重新运行 sysup 完成系统升级。"
else
  TAG_INFO="[INFO]"
  TAG_SUCCESS="[OK]"
  TAG_WARN="[WARN]"
  TAG_ERROR="[ERROR]"

  MSG[SYNCING_DATA]="⏳ Triggering sync for the latest repository data. Please wait..."
  MSG[NO_UI]="Update list command not found (shorin checkallupdates). Is shorin-contrib installed?"

  MSG[INTRO_HEADER]="=== Arch Linux System Update Assistant ==="
  MSG[INTRO_DESC]="After fetching and confirming Arch Linux news, the following steps run:"
  INTRO_STEPS=(
    "Check mirrorlist age & update if needed"
    "Sync pacman DB & update GPG keyrings"
    "Upgrade official repo packages (pacman -Su)"
    "Upgrade AUR packages"
    "Update Flatpak apps"
    "Re-generate GRUB config"
  )
  MSG[INTRO_SNAP]="(A snapshot is taken first on Btrfs when quicksave is installed)"

  MSG[REQ_SUDO]="Requesting sudo..."
  MSG[SUDO_FAIL]="Sudo privileges required. Exiting..."

  MSG[PREPARING]="Preparing update (%s)..."
  MSG[FETCHING]="Fetching news..."
  MSG[NEWS_HEADER]="Recent {0} Arch Linux news items:"
  MSG[CONFIRM]="Please read the news above. Proceed with the update?"
  MSG[CANCEL]="Update cancelled."
  MSG[ERR_FETCH]="Failed to fetch news"
  MSG[FORCE_ASK]="Force update anyway?"
  MSG[FORCING]="Forcing update..."
  MSG[EXIT]="Safe exit."

  MSG[SNAP]="Creating Btrfs snapshot..."
  MSG[SNAP_FAIL]="Btrfs snapshot failed. Continue without a snapshot?"

  MSG[STEP_MIRROR]="Checking mirrorlist age..."
  MSG[MIR_OLD]="Mirrors are %s days old (>%s). Update?"
  MSG[MIR_FRESH]="Mirrors are fresh (%s days old)."
  MSG[MIR_UPDATING]="Running mirror-update script..."
  MSG[MIR_UPDATE_FAIL]="mirror-update failed. Keeping the current mirrorlist."
  MSG[MIR_SKIP]="Skipping mirror update."
  MSG[MIR_NO_STAMP]="Mirrorlist was not generated by Reflector. Skipping."
  MSG[MIR_BAD_STAMP]="Cannot parse the Reflector timestamp. Skipping."
  MSG[MIR_NO_SCRIPT]="mirror-update script not found. Skipping mirror update."

  MSG[STEP_SYNC]="Syncing DB & keyrings..."
  MSG[KEYRING_OK]="DB & keyrings synced."
  MSG[KEYRING_WARN]="Keyring issues detected, continuing with system upgrade..."

  MSG[STEP_REPO]="Upgrading official repo packages..."
  MSG[REPO_OK]="Official repo packages upgraded. The system is fully up to date."

  MSG[STEP_AUR]="Upgrading AUR packages (%s)..."
  MSG[AUR_OK]="AUR packages upgraded."
  MSG[AUR_NONE]="No AUR helper found (paru or yay). Skipping."
  MSG[AUR_FAIL]="AUR upgrade failed or was cancelled. Official repos are upgraded; the system itself is consistent."
  MSG[AUR_RETRY]="Retry later with: %s"

  MSG[STEP_FLATPAK]="Checking Flatpak updates..."
  MSG[FLATPAK_NONE]="Flatpak not installed. Skipping."
  MSG[FLATPAK_FAIL]="Flatpak update failed. Continuing."

  MSG[STEP_GRUB]="Updating GRUB..."
  MSG[GRUB_OK]="GRUB updated."

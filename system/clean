#!/bin/bash
# 描述： 清理系统
# Description: Clean system

# 【模式说明 / Modes】
#   clean          日常模式：只删除可再生的缓存和用户已丢弃的内容
#   clean dev      开发模式：日常模式 + 各开发工具的全局缓存 (仅使用工具官方清理命令)
#   clean all      激进模式：开发模式 + 完全清空软件包缓存、AUR 克隆、应用/浏览器缓存、
#                  桌面索引、剪贴板历史、已卸载 Flatpak 残留、全部 Btrfs 快照 (保留 before 节点)
#   --dry-run      仅列出将删除的内容与预计释放空间，不执行任何删除
#
# 【日常模式功能 / Default mode】
# 1. 移除孤儿软件包与无主 debug 符号包 (Orphans & orphaned debug packages)
# 2. 清理软件包缓存 (仅保留已安装版本；all 模式完全清空)
# 3. 清理 AUR 构建残留 (删除未安装的克隆及已安装克隆中的 src/pkg/构建产物，保留 git 仓库)
# 4. 清理 systemd 日志 (先轮转再按 2 周 / 300M 收缩)
# 5. 清理崩溃转储 (systemd coredump)
# 6. 清空回收站 (含外置磁盘 .Trash-UID) 与 30 天前的缩略图
# 7. 移除未使用的 Flatpak 运行时
# 8. 清理截图与录屏文件 (默认仅删除 7 天前的文件，--media-days 可调)
# 9. 清理旧 Btrfs 快照 (number / timeline / empty-pre-post) 与 btrfs-assistant 冗余备份子卷
#
# 【安全原则 / Safety】
# - 路径从 pacman-conf / paru.conf / yay -Pg / xdg-user-dir 读取，不写死
# - 开发缓存只用工具自带的 prune 命令，从不进入项目目录
# - 正在运行的应用其缓存目录跳过
# - all 模式总是需要确认 (--yes 无效)
# - 按实际删除的文件体积统计，结尾给出可用空间变化
#   (Btrfs 上被快照引用的数据要等快照删除后才真正释放)

set -euo pipefail

# ------------------------------
# 1. Defaults & language
# ------------------------------
MODE="normal"        # normal | dev | all
SKIP_CONFIRM=false
DRY_RUN=false
MEDIA_DAYS=7
JOURNAL_KEEP_TIME="2weeks"
JOURNAL_KEEP_SIZE="300M"
THUMB_DAYS=30

if [[ "${LC_MESSAGES:-${LANG:-}}" == *zh_CN* ]]; then
  UI_LANG="zh"
else
  UI_LANG="en"
fi

# ------------------------------
# 2. Argument parsing
# ------------------------------
usage() {
  cat <<EOF
Usage: $(basename "$0") [mode] [options]

Modes:
  (none)             Daily cleanup: regenerable caches, trash, old logs
  dev, --dev         Daily + developer tool caches (npm, pnpm, pip, uv, cargo, go, docker ...)
  all, --all         Aggressive: dev + full package/AUR caches, app & browser caches,
                     desktop indexes, clipboard history, ALL btrfs snapshots (keeps 'before' nodes)

Options:
  --dry-run, -n      Only list what would be removed and the estimated space
  --yes, -y          Skip confirmation (normal/dev modes; 'all' always asks)
  --media-days N     Only delete screenshots/recordings older than N days (default 7, 0 = all)
  --ui-lang zh|en    Force UI language (default: auto)
  --help, -h         Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --ui-lang) [[ "${2:-}" =~ ^(zh|en)$ ]] && UI_LANG="$2" && shift 2 || { echo "Error: --ui-lang requires zh or en."; exit 1; } ;;
  all | --all) MODE="all"; shift ;;
  dev | --dev) [[ "$MODE" == "all" ]] || MODE="dev"; shift ;;
  --dry-run | -n) DRY_RUN=true; shift ;;
  --yes | -y) SKIP_CONFIRM=true; shift ;;
  --media-days) [[ "${2:-}" =~ ^[0-9]+$ ]] && MEDIA_DAYS="$2" && shift 2 || { echo "Error: --media-days requires a number."; exit 1; } ;;
  --help | -h) usage; exit 0 ;;
  *) echo "Unknown option: $1"; usage; exit 1 ;;
  esac
done

is_dev() { [[ "$MODE" == "dev" || "$MODE" == "all" ]]; }
is_all() { [[ "$MODE" == "all" ]]; }


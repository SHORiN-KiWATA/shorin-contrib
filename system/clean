# ------------------------------
# 4. Colors, output & helpers
# ------------------------------
NC='\033[0m'; DIM='\033[2m'
H_BLUE='\033[1;34m'; H_GREEN='\033[1;32m'; H_YELLOW='\033[1;33m'; H_RED='\033[1;31m'; H_CYAN='\033[1;36m'; C_CYAN='\033[36m'
if [[ "$UI_LANG" == "zh" ]]; then
  TAG_INFO="[消息]"; TAG_SUCCESS="[成功]"; TAG_WARN="[注意]"; TAG_SKIP="[跳过]"; TAG_PREVIEW="[预览]"
else
  TAG_INFO="[INFO]"; TAG_SUCCESS="[OK]"; TAG_WARN="[WARN]"; TAG_SKIP="[SKIP]"; TAG_PREVIEW="[PREVIEW]"
fi

_error() { printf "${H_RED}%-10s${NC} %s\n" "[ERROR]" "$*" >&2; exit 1; }

PREVIEW=false        # true in --dry-run: list only, delete nothing
TOTAL_BYTES=0        # bytes of everything listed for deletion
STEP_ITEMS=0; STEP_BYTES=0
UID_NUM=$(id -u)
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# 1536 -> "1.5 KiB"; -1 -> "-" (unknown)
fmt_bytes() {
  local b=${1:-0}
  if [[ "$b" -lt 0 ]]; then echo "-"; return; fi
  if [[ "$b" -lt 1024 ]]; then echo "${b} B"; return; fi
  numfmt --to=iec-i --format='%.1f' "$b" 2>/dev/null | sed -E 's/([KMGTPE]i)$/ \1B/'
}
# disk usage in bytes of the given existing paths (0 if none)
dir_bytes() {
  local -a ex=(); local p
  for p in "$@"; do [[ -e "$p" ]] && ex+=("$p"); done
  [[ ${#ex[@]} -eq 0 ]] && { echo 0; return; }
  du -sc --block-size=1 "${ex[@]}" 2>/dev/null | tail -1 | cut -f1
}
sudo_dir_bytes() {
  [[ $# -eq 0 ]] && { echo 0; return; }
  local s; s=$(sudo du -sc --block-size=1 "$@" 2>/dev/null | tail -1 | cut -f1); echo "${s:-0}"
}
# bytes of files matched by: find_bytes DIR [find-tests...]
find_bytes() { find "$@" -printf '%b\0' 2>/dev/null | awk 'BEGIN{RS="\0"; s=0} {s+=$0*512} END{print s+0}'; }
# free space: sum of unique filesystems backing / and $HOME
avail_bytes() {
  local total=0 seen=" " src t a
  for t in / "$HOME"; do
    src=$(findmnt -n -o SOURCE --target "$t" 2>/dev/null | head -1 | cut -d'[' -f1)
    [[ -z "$src" ]] && continue
    [[ "$seen" == *" $src "* ]] && continue
    seen="$seen$src "
    a=$(df -B1 --output=avail "$t" 2>/dev/null | tail -1 | tr -d ' ')
    total=$(( total + ${a:-0} ))
  done
  echo "$total"
}

# Tags are padded by display width (CJK = 2 columns) to the widest tag of the language + 2,
# so message text and item lines share the same column in both languages
disp_width() { local t=$1 bytes; bytes=$(printf '%s' "$t" | wc -c); echo $(( ${#t} + (bytes - ${#t}) / 2 )); }   # UTF-8 CJK: 3 bytes, 2 columns
TAG_COL=0
for _t in "$TAG_INFO" "$TAG_SUCCESS" "$TAG_WARN" "$TAG_SKIP" "$TAG_PREVIEW"; do _w=$(disp_width "$_t"); [[ $_w -gt $TAG_COL ]] && TAG_COL=$_w; done
TAG_COL=$(( TAG_COL + 2 ))
pad_tag() { local t=$1; printf '%s%*s' "$t" $(( TAG_COL - $(disp_width "$t") )) ''; }
printf -v INDENT '%*s' $(( TAG_COL + 1 )) ''
_info()    { local fmt=$1; shift; printf "${H_BLUE}%s${NC} ${fmt}\n" "$(pad_tag "$TAG_INFO")" "$@"; }
_success() { local fmt=$1; shift; printf "${H_GREEN}%s${NC} ${fmt}\n" "$(pad_tag "$TAG_SUCCESS")" "$@"; }
_warn()    { local fmt=$1; shift; printf "${H_YELLOW}%s${NC} ${fmt}\n" "$(pad_tag "$TAG_WARN")" "$@"; }
_skip()    { local fmt=$1; shift; printf "${DIM}%s${NC} ${fmt}\n" "$(pad_tag "$TAG_SKIP")" "$@"; }
_preview() { local fmt=$1; shift; printf "${H_CYAN}%s${NC} ${fmt}\n" "$(pad_tag "$TAG_PREVIEW")" "$@"; }

# step TITLE_FMT [args]    -> "[消息] 正在..." line
step() { _info "$@"; STEP_ITEMS=0; STEP_BYTES=0; }
# item BYTES TEXT          -> one deletion entry under the step (BYTES=-1 when unknown)
MIN_ITEM_BYTES=$(( 1024 * 1024 ))
item() {
  local bytes=$1; shift
  # negligible entries are still cleaned, just not listed
  if [[ "$bytes" -ge 0 && "$bytes" -lt $MIN_ITEM_BYTES ]]; then return 0; fi
  if [[ "$bytes" -ge 0 ]]; then printf "%s${DIM}-${NC} %s ${C_CYAN}(%s)${NC}\n" "$INDENT" "$*" "$(fmt_bytes "$bytes")"
  else printf "%s${DIM}-${NC} %s\n" "$INDENT" "$*"; fi
  STEP_ITEMS=$(( STEP_ITEMS + 1 ))
  if [[ "$bytes" -gt 0 ]]; then STEP_BYTES=$(( STEP_BYTES + bytes )); TOTAL_BYTES=$(( TOTAL_BYTES + bytes )); fi
}
note() { printf "%s  ${DIM}%s${NC}\n" "$INDENT" "$*"; }
skip() { _skip "$@"; }
# step_end -> "[成功] 已清理 X。" / "[成功] 完成。" / "[成功] 无需清理。"  ([预览] in dry-run)
step_end() {
  local say=_success; [[ "$PREVIEW" == true ]] && say=_preview
  if [[ $STEP_ITEMS -eq 0 ]]; then $say "${MSG[NONE]}"
  elif [[ $STEP_BYTES -gt 0 ]]; then
    if [[ "$PREVIEW" == true ]]; then $say "${MSG[STEP_PREVIEW]}" "$(fmt_bytes "$STEP_BYTES")"; else $say "${MSG[STEP_DONE]}" "$(fmt_bytes "$STEP_BYTES")"; fi
  else $say "${MSG[STEP_OK]}"; fi
}

run() { if [[ "$PREVIEW" == false ]]; then "$@"; fi; }
rm_contents() { local d=$1; [[ -d "${d:?}" ]] && run find "$d" -mindepth 1 -xdev -delete 2>/dev/null || true; }
join_words() { local IFS=' '; echo "$*"; }
# a process counts as "this app" only when NAME is a whole path component / word of its cmdline
app_running() {
  local re; re=$(printf '%s' "$1" | sed 's/[][\\.*^$/+?(){}|]/\\&/g')
  pgrep -fi -- "(^|/)${re}([ /]|\$)" 2>/dev/null | grep -v "^$$\$" | head -1 || true
}
journal_usage() { sudo journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+ ?[KMGT]?B?' | head -1 || true; }
pkgs_installed_bytes() {  # sum of "Installed Size" for the given packages (-1 when unknown)
  local s; s=$(LC_ALL=C pacman -Qi "$@" 2>/dev/null | awk -F': *' '/^Installed Size/ {print $2}' | sed 's/ //; s/iB$/i/; s/B$//' \
    | numfmt --from=iec-i 2>/dev/null | awk '{s+=$1} END{print s+0}')
  if [[ "${s:-0}" -gt 0 ]]; then echo "$s"; else echo -1; fi
}

# ------------------------------
# 5. Package manager detection
# ------------------------------
if command -v paru >/dev/null 2>&1; then PKG_MNGR=paru
elif command -v yay >/dev/null 2>&1; then PKG_MNGR=yay
elif command -v pacman >/dev/null 2>&1; then PKG_MNGR=pacman
else _error "${MSG[NO_HELPER]}"; fi

mapfile -t PAC_CACHE_DIRS < <(pacman-conf CacheDir 2>/dev/null | sed 's:/*$::' | grep . || echo /var/cache/pacman/pkg)

paru_clone_dir() {
  local f v
  for f in "$CONFIG_HOME/paru/paru.conf" /etc/paru.conf; do
    [[ -f "$f" ]] || continue
    v=$(grep -E '^\s*CloneDir\s*=' "$f" 2>/dev/null | tail -1 | cut -d= -f2- | xargs || true)
    [[ -n "$v" ]] && { echo "${v/#\~/$HOME}"; return; }
  done
  echo "$CACHE_HOME/paru/clone"
}
yay_build_dir() {
  local v; v=$(yay -Pg 2>/dev/null | grep -oP '"buildDir":\s*"\K[^"]+' || true)
  echo "${v:-$CACHE_HOME/yay}"
}
# a clone dir counts as installed when any pkgname from its .SRCINFO (or its dir name) is installed
pkgbase_installed() {
  local d=$1 name=$2 p
  pacman -Qq "$name" >/dev/null 2>&1 && return 0
  if [[ -f "$d/.SRCINFO" ]]; then
    while IFS= read -r p; do pacman -Qq "$p" >/dev/null 2>&1 && return 0; done < <(grep -E '^\s*pkgname\s*=' "$d/.SRCINFO" | cut -d= -f2 | xargs -n1 2>/dev/null)
  fi
  return 1
}

# ======================================================================
# 6. Steps  (each step lists what it removes; deletion is skipped in PREVIEW)
# ======================================================================

step_orphans() {
  step "${MSG[T_ORPHAN]}"
  local -a targets=() arr=()
  local orphans opt_orphans debugs base
  orphans=$(pacman -Qtdq 2>/dev/null || true)
  if [[ -n "$orphans" ]]; then
    mapfile -t arr <<< "$orphans"; targets+=("${arr[@]}")
    item "$(pkgs_installed_bytes "${arr[@]}")" "$(printf "${MSG[ORPHAN_LIST]}" "${#arr[@]}" "$(join_words "${arr[@]}")")"
  fi
  if is_all; then
    opt_orphans=$(comm -13 <(pacman -Qtdq 2>/dev/null | sort) <(pacman -Qttdq 2>/dev/null | sort) || true)
    if [[ -n "$opt_orphans" ]]; then
      mapfile -t arr <<< "$opt_orphans"; targets+=("${arr[@]}")
      item "$(pkgs_installed_bytes "${arr[@]}")" "$(printf "${MSG[ORPHAN_OPT_LIST]}" "${#arr[@]}" "$(join_words "${arr[@]}")")"
    fi
  fi
  debugs=""
  while IFS= read -r dbg; do
    base="${dbg%-debug}"; [[ -z "$base" ]] && continue
    pacman -Qi "$base" >/dev/null 2>&1 || debugs="${debugs:+$debugs }$dbg"
  done < <(pacman -Qq 2>/dev/null | grep -- '-debug$' || true)
  if [[ -n "$debugs" ]]; then
    read -r -a arr <<< "$debugs"; targets+=("${arr[@]}")
    item "$(pkgs_installed_bytes "${arr[@]}")" "$(printf "${MSG[ORPHAN_DEBUG_LIST]}" "$debugs")"
  fi
  if [[ ${#targets[@]} -gt 0 ]]; then
    run sudo pacman -Rns --noconfirm "${targets[@]}" >/dev/null 2>&1 || true
  fi
  step_end
}

step_pacman_cache() {
  step "${MSG[T_CACHE]}" "$(join_words "${PAC_CACHE_DIRS[@]}")"
  if is_all; then
    local n; n=$(find "${PAC_CACHE_DIRS[@]}" -maxdepth 1 -type f 2>/dev/null | wc -l)
    item "$(sudo_dir_bytes "${PAC_CACHE_DIRS[@]}")" "$(printf "${MSG[CACHE_ALL_ITEM]}" "$n")"
    # -Scc's "remove ALL files" prompt defaults to no; --noconfirm would silently skip it, so answer yes
    if [[ "$PREVIEW" == false ]]; then yes | sudo pacman -Scc >/dev/null 2>&1 || true; fi
  else
    local d saved=0 s
    if command -v paccache >/dev/null 2>&1; then
      for d in "${PAC_CACHE_DIRS[@]}"; do
        for s in "$(paccache -d -k1 -c "$d" 2>/dev/null | grep -oP 'disk space saved: \K[^)]+' || true)" \
                 "$(paccache -d -u -k0 -c "$d" 2>/dev/null | grep -oP 'disk space saved: \K[^)]+' || true)"; do
          [[ -n "$s" ]] && saved=$(( saved + $(numfmt --from=iec-i "$(echo "$s" | sed 's/ //; s/iB$/i/; s/B$//')" 2>/dev/null || echo 0) ))
        done
      done
    else
      saved=-1
    fi
    if [[ "$saved" -ne 0 ]]; then item "$saved" "${MSG[CACHE_ITEM]}"; fi
    run sudo pacman -Sc --noconfirm >/dev/null 2>&1 || true
    for d in "${PAC_CACHE_DIRS[@]}"; do run sudo find "$d" -maxdepth 1 -type d -name 'download-*' -exec rm -rf {} + 2>/dev/null || true; done
  fi
  step_end
}

step_aur_cache() {
  local -a clone_dirs=()
  command -v paru >/dev/null 2>&1 && clone_dirs+=("$(paru_clone_dir)")
  command -v yay  >/dev/null 2>&1 && clone_dirs+=("$(yay_build_dir)")
  [[ ${#clone_dirs[@]} -eq 0 ]] && return 0
  local root
  if is_all; then
    step "${MSG[T_AUR_ALL]}"
    for root in "${clone_dirs[@]}"; do
      [[ -d "$root" ]] || continue
      local n; n=$(find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
      [[ $n -eq 0 ]] && continue
      item "$(dir_bytes "$root")" "$(printf "${MSG[AUR_ALL_ITEM]}" "$n" "${root/#$HOME/\~}")"
      rm_contents "$root"
    done
    if [[ "$PREVIEW" == false ]]; then
      command -v paru >/dev/null 2>&1 && { paru -Scc --aur --noconfirm >/dev/null 2>&1 || true; }
      command -v yay  >/dev/null 2>&1 && { yay  -Scc --aur --noconfirm >/dev/null 2>&1 || true; }
    fi
    step_end; return 0
  fi

  step "${MSG[T_AUR]}"
  for root in "${clone_dirs[@]}"; do
    [[ -d "$root" ]] || continue
    local -a uninstalled=() junk=()
    local d name j
    for d in "$root"/*/; do
      [[ -d "$d" ]] || continue
      d="${d%/}"; name=$(basename "$d")
      [[ -f "$d/PKGBUILD" || -f "$d/.SRCINFO" ]] || continue     # only touch real clone dirs
      if pkgbase_installed "$d" "$name"; then
        while IFS= read -r -d '' j; do junk+=("$j"); done < <(find "$d" -mindepth 1 -maxdepth 1 \( -type d \( -name src -o -name pkg \) -o -type f \( -name '*.pkg.tar*' -o -name '*.log' \) \) -print0 2>/dev/null)
      else
        uninstalled+=("$d")
      fi
    done
    if [[ ${#uninstalled[@]} -gt 0 ]]; then
      item "$(dir_bytes "${uninstalled[@]}")" "$(printf "${MSG[AUR_UNINSTALLED]}" "$(basename -a "${uninstalled[@]}" | xargs)")"
      for d in "${uninstalled[@]}"; do run rm -rf -- "${d:?}"; done
    fi
    if [[ ${#junk[@]} -gt 0 ]]; then
      local -A seen=(); local cnt=0
      for d in "${junk[@]}"; do name=$(basename "$(dirname "$d")"); [[ -z "${seen[$name]:-}" ]] && { seen[$name]=1; cnt=$((cnt+1)); }; done
      item "$(dir_bytes "${junk[@]}")" "$(printf "${MSG[AUR_BUILD]}" "$cnt")"
      for d in "${junk[@]}"; do run rm -rf -- "${d:?}"; done
    fi
  done
  step_end
}

step_journal() {
  step "${MSG[T_LOG]}"
  local before after; before=$(journal_usage)
  item -1 "$(printf "${MSG[LOG_ITEM]}" "$JOURNAL_KEEP_TIME" "$JOURNAL_KEEP_SIZE" "${before:-?}")"
  if [[ "$PREVIEW" == false ]]; then
    sudo journalctl --rotate >/dev/null 2>&1 || true
    sudo journalctl --vacuum-time="$JOURNAL_KEEP_TIME" --vacuum-size="$JOURNAL_KEEP_SIZE" >/dev/null 2>&1 || true
    after=$(journal_usage)
    note "$(printf "${MSG[LOG_RESULT]}" "${before:-?}" "${after:-?}")"
  fi
  step_end
}

step_coredump() {
  local d=/var/lib/systemd/coredump
  [[ -d "$d" ]] || return 0
  step "${MSG[T_CORE]}"
  local n; n=$(sudo find "$d" -maxdepth 1 -type f -name 'core.*' 2>/dev/null | wc -l)
  if [[ $n -gt 0 ]]; then
    item "$(sudo_dir_bytes "$d")" "$(printf "${MSG[CORE_ITEM]}" "$n")"
    run sudo find "$d" -maxdepth 1 -type f -name 'core.*' -delete 2>/dev/null || true
  fi
  step_end
}

step_trash_thumbs() {
  step "${MSG[T_TRASH]}"
  local -a trash=()
  [[ -d "$DATA_HOME/Trash" ]] && trash+=("$DATA_HOME/Trash")
  local m
  while IFS= read -r m; do
    [[ "$m" == /run/media/* || "$m" == /media/* || "$m" == /mnt/* ]] || continue
    [[ -d "$m/.Trash-$UID_NUM" ]] && trash+=("$m/.Trash-$UID_NUM")
  done < <(findmnt -rn -o TARGET 2>/dev/null || true)
  local t bytes
  for t in "${trash[@]}"; do
    bytes=$(dir_bytes "$t")
    [[ "$bytes" -gt 4096 ]] || continue          # empty trash dirs only hold files/ and info/
    item "$bytes" "$(printf "${MSG[TRASH_ITEM]}" "${t/#$HOME/\~}")"
    rm_contents "$t"
  done

  local thumb="$CACHE_HOME/thumbnails"
  if [[ -d "$thumb" ]]; then
    local -a cond=(-type f); is_all || cond+=(-mtime "+$THUMB_DAYS")
    local n; n=$(find "$thumb" -xdev "${cond[@]}" 2>/dev/null | wc -l)
    if [[ $n -gt 0 ]]; then
      if is_all; then item "$(find_bytes "$thumb" -xdev "${cond[@]}")" "$(printf "${MSG[THUMB_ALL_ITEM]}" "$n")"
      else item "$(find_bytes "$thumb" -xdev "${cond[@]}")" "$(printf "${MSG[THUMB_ITEM]}" "$n" "$THUMB_DAYS")"; fi
      run find "$thumb" -xdev "${cond[@]}" -delete 2>/dev/null || true
    fi
  fi
  step_end
}

step_flatpak() {
  command -v flatpak >/dev/null 2>&1 || return 0
  step "${MSG[T_FLATPAK]}"
  local unused
  unused=$(printf 'n\n' | flatpak uninstall --unused 2>/dev/null | grep -oE '\[-\]\s+\S+' | awk '{print $2}' | xargs || true)
  if [[ -n "$unused" ]]; then
    item -1 "$(printf "${MSG[FLATPAK_ITEM]}" "$unused")"
    run flatpak uninstall --unused -y >/dev/null 2>&1 || true
  fi
  if is_all && [[ -d "$HOME/.var/app" ]]; then
    local installed; installed=$(flatpak list --app --columns=application 2>/dev/null || true)
    local -a orphan=() caches=()
    local d id
    for d in "$HOME"/.var/app/*/; do
      [[ -d "$d" ]] || continue; d="${d%/}"; id=$(basename "$d")
      if grep -qxF "$id" <<< "$installed"; then
        [[ -d "$d/cache" ]] && caches+=("$d/cache")
      else
        orphan+=("$d")
      fi
    done
    if [[ ${#orphan[@]} -gt 0 ]]; then
      item "$(dir_bytes "${orphan[@]}")" "$(printf "${MSG[FLATPAK_ORPHAN_ITEM]}" "${#orphan[@]}" "$(basename -a "${orphan[@]}" | xargs)")"
      for d in "${orphan[@]}"; do run rm -rf -- "${d:?}"; done
    fi
    if [[ ${#caches[@]} -gt 0 ]]; then
      item "$(dir_bytes "${caches[@]}")" "${MSG[FLATPAK_APPCACHE_ITEM]}"
      for d in "${caches[@]}"; do rm_contents "$d"; done
    fi
  fi
  step_end
}

step_media() {
  local pics="" vids=""
  if command -v xdg-user-dir >/dev/null 2>&1; then pics=$(xdg-user-dir PICTURES); vids=$(xdg-user-dir VIDEOS); fi
  # xdg-user-dir falls back to $HOME itself when a dir is not configured
  [[ -z "$pics" || "$pics" == "$HOME" ]] && pics="$HOME/Pictures"
  [[ -z "$vids" || "$vids" == "$HOME" ]] && vids="$HOME/Videos"
  local -a dirs=("$pics/Screenshots" "$vids/wf-recorder" "$vids/shorin-screenrec-menu")
  local -a cond=(-type f)
  if [[ "$MEDIA_DAYS" -gt 0 ]]; then step "${MSG[T_MEDIA]}" "$MEDIA_DAYS"; cond+=(-mtime "+$MEDIA_DAYS")
  else step "${MSG[T_MEDIA_ALL]}"; fi
  local d n
  for d in "${dirs[@]}"; do
    [[ -d "$d" ]] || continue
    n=$(find "$d" -xdev "${cond[@]}" 2>/dev/null | wc -l)
    [[ $n -eq 0 ]] && continue
    item "$(find_bytes "$d" -xdev "${cond[@]}")" "$(printf "${MSG[MEDIA_ITEM]}" "${d/#$HOME/\~}" "$n")"
    run find "$d" -xdev "${cond[@]}" -delete 2>/dev/null || true
    run find "$d" -xdev -mindepth 1 -type d -empty -delete 2>/dev/null || true
  done
  step_end
}

snapper_configs() { sudo LC_ALL=C snapper list-configs 2>/dev/null | awk -F '|' 'NR>2 {print $1}' | xargs -n1 2>/dev/null || true; }

step_snapshots() {
  command -v btrfs >/dev/null 2>&1 && findmnt -f -n -o FSTYPE / | grep -q btrfs || return 0
  if command -v snapper >/dev/null 2>&1; then
    local conf
    if is_all; then
      step "${MSG[T_SNAP_ALL]}"
      while IFS= read -r conf; do
        [[ -z "$conf" ]] && continue
        if ! snapper -c "$conf" get-config >/dev/null 2>&1; then
          run sudo snapper -c "$conf" set-config ALLOW_GROUPS=wheel SYNC_ACL=yes >/dev/null 2>&1 || true
        fi
        local -a ids=()
        while IFS='|' read -r snap_id _ _ _ _ _ snap_desc _; do
          snap_id=$(echo "$snap_id" | xargs); snap_desc=$(echo "$snap_desc" | xargs)
          [[ ! "$snap_id" =~ ^[0-9]+$ ]] && continue
          [[ "$snap_id" == "0" ]] && continue                 # 0 is the live system
          [[ "${snap_desc,,}" == before* ]] && continue        # keep 'Before' nodes
          ids+=("$snap_id")
        done < <(sudo LC_ALL=C snapper -c "$conf" list 2>/dev/null)
        [[ ${#ids[@]} -eq 0 ]] && continue
        item -1 "$(printf "${MSG[SNAP_ALL_ITEM]}" "$conf" "${#ids[@]}" "$(printf '#%s ' "${ids[@]}" | xargs)")"
        if [[ "$PREVIEW" == false ]]; then
          sudo snapper -c "$conf" delete "${ids[@]}" >/dev/null 2>&1 || true
        fi
      done < <(snapper_configs)
    else
      step "${MSG[T_SNAP]}"
      while IFS= read -r conf; do
        [[ -z "$conf" ]] && continue
        item -1 "$(printf "${MSG[SNAP_ITEM]}" "$conf")"
        if [[ "$PREVIEW" == false ]]; then
          sudo snapper -c "$conf" cleanup number >/dev/null 2>&1 || true
          sudo snapper -c "$conf" cleanup timeline >/dev/null 2>&1 || true
          sudo snapper -c "$conf" cleanup empty-pre-post >/dev/null 2>&1 || true
        fi
      done < <(snapper_configs)
    fi
    step_end
  fi

  # btrfs-assistant backups (*_backup_20*) at the top level of the filesystem
  step "${MSG[T_BTRFS_BA]}"
  local dev mnt; dev=$(findmnt -n -o SOURCE / | cut -d'[' -f1); mnt=$(mktemp -d /tmp/btrfs_clean_XXXX)
  if sudo mount -t btrfs -o subvolid=5 "$dev" "$mnt" 2>/dev/null; then
    local -a subvols=(); local s
    while IFS= read -r -d '' s; do sudo btrfs subvolume show "$s" >/dev/null 2>&1 && subvols+=("$s"); done \
      < <(sudo find "$mnt" -maxdepth 1 -type d -name "*_backup_20*" -print0 2>/dev/null | sort -z)
    if [[ ${#subvols[@]} -gt 0 ]] && ! is_all; then
      note "$(printf "${MSG[BTRFS_BA_KEEP]}" "$(basename "${subvols[-1]}")")"
      unset 'subvols[-1]'
    fi
    for s in "${subvols[@]}"; do
      item -1 "$(basename "$s")"
      run sudo btrfs subvolume delete "$s" >/dev/null 2>&1 || true
    done
    sudo umount "$mnt" 2>/dev/null || true
  fi
  rmdir "$mnt" 2>/dev/null || true
  if [[ "$PREVIEW" == false ]]; then sudo btrfs filesystem sync / >/dev/null 2>&1 || true; fi
  step_end
}

# ---- dev caches: official prune commands only, never project directories ----
step_dev_caches() {
  is_dev || return 0
  step "${MSG[T_DEV]}"
  local dir

  dev_item() { # dev_item BYTES LABEL CMD...
    local bytes=$1 label=$2; shift 2
    item "$bytes" "$label"
    if [[ "$PREVIEW" == false ]]; then "$@" >/dev/null 2>&1 || true; fi
  }
  wipe_dir() { find "$1" -mindepth 1 -xdev -delete; }

  if command -v npm >/dev/null 2>&1; then
    dir=$(npm config get cache 2>/dev/null || true); [[ -d "${dir:-/nonexistent}/_cacache" ]] && dev_item "$(dir_bytes "$dir/_cacache")" "npm cache  ${dir/#$HOME/\~}" npm cache clean --force
  fi
  if command -v pnpm >/dev/null 2>&1; then
    dir=$(pnpm store path 2>/dev/null || true); [[ -d "${dir:-/nonexistent}" ]] && dev_item -1 "pnpm store prune  ${dir/#$HOME/\~}" pnpm store prune
  fi
  if command -v yarn >/dev/null 2>&1; then
    dir=$(yarn cache dir 2>/dev/null || true); [[ -d "${dir:-/nonexistent}" ]] && dev_item "$(dir_bytes "$dir")" "yarn cache  ${dir/#$HOME/\~}" yarn cache clean
  fi
  if command -v bun >/dev/null 2>&1; then
    dir="$HOME/.bun/install/cache"; [[ -d "$dir" ]] && dev_item "$(dir_bytes "$dir")" "bun cache  ${dir/#$HOME/\~}" bun pm cache rm
  fi
  if command -v pip >/dev/null 2>&1; then
    dir=$(pip cache dir 2>/dev/null || true); [[ -d "${dir:-/nonexistent}" ]] && dev_item "$(dir_bytes "$dir")" "pip cache  ${dir/#$HOME/\~}" pip cache purge
  fi
  if command -v uv >/dev/null 2>&1; then
    dir=$(uv cache dir 2>/dev/null || true)
    if [[ -d "${dir:-/nonexistent}" ]]; then
      if is_all; then dev_item "$(dir_bytes "$dir")" "uv cache clean  ${dir/#$HOME/\~}" uv cache clean
      else dev_item -1 "uv cache prune  ${dir/#$HOME/\~}" uv cache prune; fi
    fi
  fi
  if command -v cargo >/dev/null 2>&1; then
    local ch="${CARGO_HOME:-$HOME/.cargo}"; local -a cd=()
    for dir in "$ch/registry/cache" "$ch/registry/src" "$ch/git/checkouts"; do [[ -d "$dir" ]] && cd+=("$dir"); done
    [[ ${#cd[@]} -gt 0 ]] && dev_item "$(dir_bytes "${cd[@]}")" "cargo registry cache / src, git checkouts  ${ch/#$HOME/\~}" bash -c 'for d in "$@"; do find "$d" -mindepth 1 -xdev -delete; done' _ "${cd[@]}"
  fi
  if command -v go >/dev/null 2>&1; then
    local gm gc; gm=$(go env GOMODCACHE 2>/dev/null || true); gc=$(go env GOCACHE 2>/dev/null || true)
    [[ -d "${gm:-/nonexistent}" || -d "${gc:-/nonexistent}" ]] && dev_item "$(dir_bytes "${gm:-/nonexistent}" "${gc:-/nonexistent}")" "go module & build cache" go clean -modcache -cache
  fi
  local gh="${GRADLE_USER_HOME:-$HOME/.gradle}"
  [[ -d "$gh/caches" ]] && dev_item "$(dir_bytes "$gh/caches")" "gradle caches  ${gh/#$HOME/\~}/caches" wipe_dir "$gh/caches"
  is_all && [[ -d "$gh/wrapper/dists" ]] && dev_item "$(dir_bytes "$gh/wrapper/dists")" "gradle wrapper dists" wipe_dir "$gh/wrapper/dists"
  if command -v conda >/dev/null 2>&1; then dev_item -1 "conda clean --all" conda clean -ay; fi

  local eng
  for eng in docker podman; do
    command -v "$eng" >/dev/null 2>&1 || continue
    "$eng" info >/dev/null 2>&1 || continue
    if is_all; then
      local recl recl_b; recl=$("$eng" system df 2>/dev/null | awk 'NR>1 && $1=="Images"{print $(NF-1)}' || true)
      recl_b=$(numfmt --from=si "${recl%B}" 2>/dev/null || echo -1)
      dev_item "$recl_b" "$(printf "${MSG[DOCKER_ALL_ITEM]}" "$eng")" bash -c '"$1" image prune -af && "$1" builder prune -af' _ "$eng"
    else
      dev_item -1 "$(printf "${MSG[DOCKER_ITEM]}" "$eng")" bash -c '"$1" image prune -f && "$1" builder prune -f' _ "$eng"
    fi
  done

  if command -v debtap >/dev/null 2>&1 && [[ -d /var/cache/debtap ]]; then
    dev_item "$(sudo_dir_bytes /var/cache/debtap)" "debtap database  /var/cache/debtap (rebuilt by debtap -u)" sudo find /var/cache/debtap -mindepth 1 -xdev -delete
  fi
  for dir in "$CACHE_HOME/zig" "$CACHE_HOME/node-gyp" "$CACHE_HOME/electron" "$CACHE_HOME/electron-builder"; do
    [[ -d "$dir" ]] && [[ "$(dir_bytes "$dir")" -gt 4096 ]] && dev_item "$(dir_bytes "$dir")" "${dir/#$HOME/\~}" wipe_dir "$dir"
  done
  if is_all && [[ -d "$CACHE_HOME/ms-playwright" ]]; then
    dev_item "$(dir_bytes "$CACHE_HOME/ms-playwright")" "playwright browsers  ~/.cache/ms-playwright" wipe_dir "$CACHE_HOME/ms-playwright"
  fi
  step_end
}

# ---- all mode: Electron app & browser caches, skipping running apps ----
step_app_caches() {
  is_all || return 0
  step "${MSG[T_APPCACHE]}"
  declare -A by_app=()
  local p app
  while IFS= read -r -d '' p; do
    app="${p#$CONFIG_HOME/}"; app="${app%%/*}"
    by_app[$app]="${by_app[$app]:-}${by_app[$app]:+$'\n'}$p"
  done < <(find "$CONFIG_HOME" -mindepth 2 -maxdepth 3 -type d \( -name Cache -o -name 'Code Cache' -o -name GPUCache -o -name DawnCache -o -name DawnGraphiteCache -o -name DawnWebGPUCache -o -name CachedData \) -print0 2>/dev/null)
  while IFS= read -r -d '' p; do
    app="${p#$CACHE_HOME/}"; app="${app%%/*}"
    by_app[$app]="${by_app[$app]:-}${by_app[$app]:+$'\n'}$p"
  done < <(find "$CACHE_HOME" -mindepth 2 -maxdepth 4 -type d \( -name Cache -o -name 'Code Cache' -o -name GPUCache -o -name cache2 \) -print0 2>/dev/null)

  declare -A proc_name=([mozilla]=firefox [BraveSoftware]=brave [google-chrome]=chrome [microsoft-edge]=msedge [google-chrome-headless]=chrome)
  local pid
  while IFS= read -r app; do
    [[ -z "$app" ]] && continue
    local -a dirs; mapfile -t dirs <<< "${by_app[$app]}"
    pid=$(app_running "${proc_name[$app]:-$app}")
    if [[ -n "$pid" ]]; then _skip "${MSG[APPCACHE_RUNNING]}" "$app"; continue; fi
    local bytes; bytes=$(dir_bytes "${dirs[@]}")
    [[ "$bytes" -gt 65536 ]] || continue        # skip apps whose caches are effectively empty
    item "$bytes" "$(printf "${MSG[APPCACHE_ITEM]}" "$app" "${#dirs[@]}")"
    for p in "${dirs[@]}"; do rm_contents "$p"; done
  done < <(printf '%s\n' "${!by_app[@]}" | sort -f)
  step_end
}

step_misc_all() {
  is_all || return 0
  step "${MSG[T_MISC]}"
  if command -v cliphist >/dev/null 2>&1 && [[ -f "$CACHE_HOME/cliphist/db" ]]; then
    item "$(dir_bytes "$CACHE_HOME/cliphist")" "${MSG[CLIP_ITEM]}"; run cliphist wipe >/dev/null 2>&1 || true
  fi
  local bctl; bctl=$(command -v balooctl6 || command -v balooctl || true)
  if [[ -n "$bctl" && -d "$DATA_HOME/baloo" ]]; then
    item "$(dir_bytes "$DATA_HOME/baloo")" "$(printf "${MSG[INDEX_ITEM]}" baloo)"; run "$bctl" purge >/dev/null 2>&1 || true
  fi
  if command -v tracker3 >/dev/null 2>&1 && [[ -d "$CACHE_HOME/tracker3" ]]; then
    item "$(dir_bytes "$CACHE_HOME/tracker3")" "$(printf "${MSG[INDEX_ITEM]}" tracker3)"
    if [[ "$PREVIEW" == false ]]; then yes 2>/dev/null | tracker3 reset --filesystem >/dev/null 2>&1 || true; fi
  fi
  step_end
}

run_all_steps() {
  step_orphans
  step_pacman_cache
  step_aur_cache
  step_journal
  step_coredump
  step_trash_thumbs
  step_flatpak
  step_media
  step_dev_caches
  step_app_caches
  step_misc_all
  step_snapshots
}

# ======================================================================
# 7. Intro, confirmation, execution
# ======================================================================
mode_label() { case "$MODE" in all) echo "${MSG[MODE_ALL]}";; dev) echo "${MSG[MODE_DEV]}";; *) echo "${MSG[MODE_NORMAL]}";; esac; }

AVAIL_BEFORE=$(avail_bytes)
printf "\n${H_CYAN}%s${NC}\n" "${MSG[INTRO_HEADER]}"
printf "${MSG[MODE_LINE]}" "$(mode_label)"
[[ "$DRY_RUN" == true ]] && printf "  ${H_YELLOW}%s${NC}" "${MSG[PREVIEW_TAG]}"
printf "    ${MSG[AVAIL]}\n" "$(fmt_bytes "$AVAIL_BEFORE")"

if [[ "$DRY_RUN" == false ]] && { is_all || [[ "$SKIP_CONFIRM" == false ]]; }; then
  printf "%s\n" "${MSG[DESC_TITLE]}"
  printf "  %s\n" "${MSG[DESC_1]}" "${MSG[DESC_2]}" "${MSG[DESC_3]}"
  printf "  ${MSG[DESC_4]}\n" "$JOURNAL_KEEP_TIME" "$JOURNAL_KEEP_SIZE"
  printf "  %s\n" "${MSG[DESC_5]}"
  printf "  ${MSG[DESC_6]}\n" "$THUMB_DAYS"
  printf "  %s\n" "${MSG[DESC_7]}"
  if [[ "$MEDIA_DAYS" -gt 0 ]]; then printf "  ${MSG[DESC_8]}\n" "$MEDIA_DAYS"; else printf "  %s\n" "${MSG[DESC_8_ALL]}"; fi
  printf "  %s\n" "${MSG[DESC_9]}"
  is_dev && printf "  ${H_YELLOW}%s${NC}\n" "${MSG[DESC_DEV]}"
  if is_all; then
    printf "  ${H_RED}%s${NC}\n" "${MSG[DESC_ALL_1]}" "${MSG[DESC_ALL_2]}" "${MSG[DESC_ALL_3]}"
    # ALL mode always asks, regardless of --yes
    printf "\n${H_RED}%s ${NC}" "${MSG[ASK_CONFIRM_ALL]}"
    read -r confirm || true
    case "$confirm" in [yY][eE][sS]|[yY]) ;; *) printf "%s\n" "${MSG[ABORT]}"; exit 0 ;; esac
  else
    printf "${DIM}%s${NC}\n" "${MSG[DESC_HINT]}"
    printf "\n${H_YELLOW}%s ${NC}" "${MSG[ASK_CONFIRM]}"
    read -r confirm || true
    case "$confirm" in [yY][eE][sS]|[yY]|"") ;; *) printf "%s\n" "${MSG[ABORT]}"; exit 0 ;; esac
  fi
fi
printf "\n"
_info "${MSG[HELPER_USE]}" "$PKG_MNGR"

# sudo keep-alive (needed for preview too: journal size, coredump, snapper)
if sudo -n true 2>/dev/null || sudo -v; then
  ( while true; do sudo -n true; sleep 60; done ) >/dev/null 2>&1 &
  SUDO_PID=$!
  trap 'pkill -P $SUDO_PID 2>/dev/null; kill $SUDO_PID 2>/dev/null || true' EXIT
else
  _error "${MSG[SUDO_FAIL]}"
fi

[[ "$DRY_RUN" == true ]] && PREVIEW=true
run_all_steps

printf "\n"
if [[ "$PREVIEW" == true ]]; then
  _preview "${MSG[DRY_DONE]}" "$(fmt_bytes "$TOTAL_BYTES")"
else
  sync
  AVAIL_AFTER=$(avail_bytes)
  _success "${MSG[DONE]}" "$(fmt_bytes "$TOTAL_BYTES")" "$(fmt_bytes "$AVAIL_BEFORE")" "$(fmt_bytes "$AVAIL_AFTER")"
  if findmnt -f -n -o FSTYPE / | grep -q btrfs && command -v snapper >/dev/null 2>&1; then
    printf "%s${DIM}%s${NC}\n" "$INDENT" "${MSG[BTRFS_NOTE]}"
  fi
fi
